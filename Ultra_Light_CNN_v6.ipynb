   "source": [
    "\n",
    "best_key = max(results, key=lambda k: results[k][\"noisy_acc\"])\n",
    "print(f\"Best configuration: size={best_key[0]}, epochs={best_key[1]} \"\n",
    "      f\"(noisy test acc with TTA {results[best_key]['noisy_acc']:.4f})\")\n",
    "\n",
    "\n",
    "def plot_loss(hist, n, epochs):\n",
    "    fig, ax = plt.subplots(figsize=(7, 4.5))\n",
    "    ax.plot(hist[\"train_loss\"], label=\"Training Loss\")\n",
    "    ax.plot(hist[\"val_loss\"], label=\"Validation Loss\")\n",
    "    ax.set_title(f\"Training vs Validation Loss ({MODEL_NAME})\\nsize={n}, epochs={epochs}\")\n",
    "    ax.set_xlabel(\"Epochs\")\n",
    "    ax.set_ylabel(\"Loss\")\n",
    "    ax.legend()\n",
    "    return fig\n",
    "\n",
    "\n",
    "def plot_confusion(y_true, y_pred, n, epochs):\n",
    "    cm = confusion_matrix(y_true, y_pred, labels=list(range(10)))\n",
    "    fig, ax = plt.subplots(figsize=(7, 6))\n",
    "    im = ax.imshow(cm, cmap=\"Blues\")\n",
    "    ax.set_title(f\"Confusion matrix for {MODEL_NAME} (size={n}, epochs={epochs})\")\n",
    "    ax.set_xticks(range(10)); ax.set_yticks(range(10))\n",
    "    ax.set_xlabel(\"Predicted label\"); ax.set_ylabel(\"True label\")\n",
    "    fig.colorbar(im, ax=ax)\n",
    "    thresh = cm.max() / 2\n",
    "    for i in range(10):\n",
    "        for j in range(10):\n",
    "            ax.text(j, i, cm[i, j], ha=\"center\", va=\"center\",\n",
    "                    color=\"white\" if cm[i, j] > thresh else \"black\")\n",
    "    fig.tight_layout()\n",
    "    return fig\n",
    "\n",
    "\n",
    "def plot_samples(r, n, epochs, count=20):\n",
    "    # Random noisy test images with true / predicted label (green = correct, red = wrong).\n",
    "    idx = np.random.RandomState(SEED).choice(len(r[\"y_te\"]), count, replace=False)\n",
    "    fig, axes = plt.subplots(4, 5, figsize=(10, 9))\n",
    "    for ax, i in zip(axes.ravel(), idx):\n",
    "        true_label, pred = int(r[\"y_te\"][i]), int(r[\"noisy_pred\"][i])\n",
    "        ax.imshow(r[\"X_te_noisy\"][i, 0], cmap=\"gray\")\n",
    "        ax.set_title(f\"True: {true_label} | Pred: {pred}\", fontsize=10,\n",
    "                     color=\"green\" if pred == true_label else \"red\")\n",
    "        ax.axis(\"off\")\n",
    "    fig.suptitle(f\"Noisy test samples ({MODEL_NAME}, size={n}, epochs={epochs})\")\n",
    "    fig.tight_layout()\n",
    "    return fig\n",
    "\n",
    "\n",
    "def plot_10_digits(r, n, epochs):\n",
    "    # One test image per digit 0-9: Original / Test (noisy) / Result (prediction).\n",
    "    y_te = r[\"y_te\"]\n",
    "    idx = [int((y_te == d).nonzero()[0]) for d in range(10)]\n",
    "    probs = predict_tta(r[\"model\"], r[\"X_te_noisy\"][idx], return_probs=True)\n",
    "    fig, axes = plt.subplots(10, 3, figsize=(5, 16))\n",
    "    for row, i in enumerate(idx):\n",
    "        pred = int(probs[row].argmax())\n",
    "        axes[row, 0].imshow(r[\"X_te\"][i, 0], cmap=\"gray\")\n",
    "        axes[row, 1].imshow(r[\"X_te_noisy\"][i, 0], cmap=\"gray\")\n",
    "        axes[row, 2].imshow(r[\"X_te\"][i, 0], cmap=\"gray\")\n",
    "        axes[row, 2].set_title(f\"Pred: {pred} ({probs[row, pred]:.0%})\", fontsize=9,\n",
    "                               color=\"green\" if pred == int(y_te[i]) else \"red\")\n",
    "        for c in range(3):\n",
    "            axes[row, c].axis(\"off\")\n",
    "    for c, name in enumerate([\"Original\", \"Test\", \"Result\"]):\n",
    "        axes[0, c].text(0.5, 1.35, name, ha=\"center\", transform=axes[0, c].transAxes)\n",
    "    fig.tight_layout()\n",
    "    return fig\n",
    "\n",
    "\n",
    "def save_fig(fig, filename, show=False):\n",
    "    fig.savefig(OUTPUT_DIR / filename, dpi=150, bbox_inches=\"tight\")\n",
    "    if show:\n",
    "        plt.show()\n",
    "    plt.close(fig)\n",
    "\n",
    "\n",
    "for (n, epochs), r in results.items():\n",
    "    show = (n, epochs) == best_key          # display only the best run in the notebook\n",
    "    tag = f\"size{n}_epochs{epochs}\"\n",
    "    save_fig(plot_loss(r[\"hist\"], n, epochs), f\"graph_loss_{tag}.png\", show)\n",
    "    save_fig(plot_confusion(r[\"y_te\"].numpy(), r[\"noisy_pred\"].numpy(), n, epochs), f\"graph_confusion_{tag}.png\", show)\n",
    "    save_fig(plot_samples(r, n, epochs), f\"graph_samples_{tag}.png\", show)\n",
    "    save_fig(plot_10_digits(r, n, epochs), f\"result_10_digits_{tag}.png\", show)\n",
    "\n",
    "print(\"Saved graphs for\", len(results), \"runs in\", OUTPUT_DIR)\n"
   ]
