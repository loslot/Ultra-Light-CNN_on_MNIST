    "## 6. Model: Ultra-Light CNN"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "c012",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "UltraLightCNN(\n",
      "  (features): Sequential(\n",
      "    (0): Conv2d(1, 16, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1), bias=False)\n",
      "    (1): BatchNorm2d(16, eps=1e-05, momentum=0.1, affine=True, bias=True, track_running_stats=True)\n",
      "    (2): ReLU()\n",
      "    (3): MaxPool2d(kernel_size=2, stride=2, padding=0, dilation=1, ceil_mode=False)\n",
      "    (4): Conv2d(16, 32, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1), bias=False)\n",
      "    (5): BatchNorm2d(32, eps=1e-05, momentum=0.1, affine=True, bias=True, track_running_stats=True)\n",
      "    (6): ReLU()\n",
      "    (7): MaxPool2d(kernel_size=2, stride=2, padding=0, dilation=1, ceil_mode=False)\n",
      "    (8): Conv2d(32, 48, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1), bias=False)\n",
      "    (9): BatchNorm2d(48, eps=1e-05, momentum=0.1, affine=True, bias=True, track_running_stats=True)\n",
      "    (10): ReLU()\n",
      "    (11): AdaptiveAvgPool2d(output_size=3)\n",
      "  )\n",
      "  (dropout): Dropout(p=0.3, inplace=False)\n",
      "  (classifier): Linear(in_features=432, out_features=10, bias=True)\n",
      ")\n",
      "Trainable parameters: 23,098\n"
     ]
    }
   ],
   "source": [
    "class UltraLightCNN(nn.Module):\n",
    "    # 3 small conv blocks + 3x3 pooled feature map + dropout + 1 linear layer.\n",
    "    def __init__(self, channels=(16, 32, 48), pool=3, dropout=0.3, num_classes=10):\n",
    "        super().__init__()\n",
    "        c1, c2, c3 = channels\n",
    "        self.features = nn.Sequential(\n",
    "            nn.Conv2d(1, c1, 3, padding=1, bias=False), nn.BatchNorm2d(c1), nn.ReLU(), nn.MaxPool2d(2),\n",
    "            nn.Conv2d(c1, c2, 3, padding=1, bias=False), nn.BatchNorm2d(c2), nn.ReLU(), nn.MaxPool2d(2),\n",
    "            nn.Conv2d(c2, c3, 3, padding=1, bias=False), nn.BatchNorm2d(c3), nn.ReLU(),\n",
    "            nn.AdaptiveAvgPool2d(pool),\n",
    "        )\n",
    "        self.dropout = nn.Dropout(dropout)\n",
    "        self.classifier = nn.Linear(c3 * pool * pool, num_classes)\n",
    "\n",
    "    def forward(self, x):\n",
    "        x = (x - 0.1307) / 0.3081  # MNIST normalization\n",
    "        return self.classifier(self.dropout(self.features(x).flatten(1)))\n",
    "\n",
    "\n",
    "def count_params(model):\n",
    "    return sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
    "\n",
    "\n",
    "print(UltraLightCNN())\n",
    "print(\"Trainable parameters:\", f\"{count_params(UltraLightCNN()):,}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c013",
   "metadata": {},
   "source": [
    "## 7. Training and evaluation functions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "c014",
   "metadata": {},
   "outputs": [],
   "source": [
    "def augment_batch(x, rot=10, shift=0.07, scale=0.08, shear=0.1, max_noise=0.25):\n",
    "    # Training-only augmentation: random affine transform + gradient noise and blur similar to the test-set corruption.\n",
    "    n = x.size(0)\n",
    "    angle = (torch.rand(n) * 2 - 1) * rot * math.pi / 180\n",
    "    s = 1 + (torch.rand(n) * 2 - 1) * scale\n",
    "    tx = (torch.rand(n) * 2 - 1) * shift * 2\n",
    "    ty = (torch.rand(n) * 2 - 1) * shift * 2\n",
    "    sh = (torch.rand(n) * 2 - 1) * shear\n",
    "    theta = torch.zeros(n, 2, 3)\n",
    "    theta[:, 0, 0] = torch.cos(angle) / s\n",
    "    theta[:, 0, 1] = (-torch.sin(angle) + sh) / s\n",
    "    theta[:, 0, 2] = tx\n",
    "    theta[:, 1, 0] = torch.sin(angle) / s\n",
    "    theta[:, 1, 1] = torch.cos(angle) / s\n",
    "    theta[:, 1, 2] = ty\n",
    "    grid = F.affine_grid(theta, x.shape, align_corners=False)\n",
    "    out = F.grid_sample(x, grid, padding_mode=\"zeros\", align_corners=False)\n",
    "\n",
    "    level = 0.05 + torch.rand(n) * (max_noise - 0.05)\n",
    "    gen = torch.Generator().manual_seed(int(torch.randint(0, 10**9, (1,))))\n",
    "    out = add_gradient_noise(out, level=level, blur_sigma=0, generator=gen)\n",
    "    if random.random() < 0.8:\n",
    "        sigma = random.uniform(0.5, 1.0)\n",
    "        out = gaussian_blur(out, kernel_size=[3, 3], sigma=[sigma, sigma])\n",
    "    return out\n",
    "\n",
    "\n",
    "criterion = nn.CrossEntropyLoss()\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def evaluate(model, X, y, batch_size=1000):\n",
    "    model.eval()\n",
    "    total_loss, preds = 0.0, []\n",
    "    for i in range(0, len(y), batch_size):\n",
    "        xb, yb = X[i:i + batch_size].to(DEVICE), y[i:i + batch_size].to(DEVICE)\n",
    "        logits = model(xb)\n",
    "        total_loss += criterion(logits, yb).item() * len(yb)\n",
    "        preds.append(logits.argmax(1).cpu())\n",
    "    preds = torch.cat(preds)\n",
    "    return total_loss / len(y), (preds == y).float().mean().item(), preds\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def evaluate_metrics(model, X, y, batch_size=1000):\n",
    "    # Returns loss (cross-entropy), accuracy, MAE and MSE.\n",
    "    # MAE / MSE compare the softmax probabilities with the one-hot labels (0 = perfect).\n",
    "    model.eval()\n",
    "    loss = correct = mae = mse = 0.0\n",
    "    for i in range(0, len(y), batch_size):\n",
    "        xb, yb = X[i:i + batch_size].to(DEVICE), y[i:i + batch_size].to(DEVICE)\n",
    "        logits = model(xb)\n",
    "        probs = torch.softmax(logits, dim=1)\n",
    "        onehot = F.one_hot(yb, 10).float()\n",
    "        loss += criterion(logits, yb).item() * len(yb)\n",
    "        correct += (logits.argmax(1) == yb).sum().item()\n",
    "        mae += (probs - onehot).abs().mean(1).sum().item()\n",
    "        mse += ((probs - onehot) ** 2).mean(1).sum().item()\n",
    "    n = len(y)\n",
    "    return loss / n, correct / n, mae / n, mse / n\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def predict_tta(model, X, return_probs=False, batch_size=500):\n",
    "    # Test-time augmentation: average the softmax over the image and its 8 one-pixel shifts.\n",
    "    model.eval()\n",
    "    out = []\n",
    "    for i in range(0, len(X), batch_size):\n",
    "        xb = X[i:i + batch_size].to(DEVICE)\n",
    "        shifts = [(dy, dx) for dy in (-1, 0, 1) for dx in (-1, 0, 1)]   # (0, 0) is the original image\n",
    "        views = [torch.roll(xb, shifts=sh, dims=(2, 3)) for sh in shifts]\n",
    "        out.append(sum(torch.softmax(model(v), dim=1) for v in views).cpu() / len(views))\n",
    "    probs = torch.cat(out)\n",
    "    return probs if return_probs else probs.argmax(1)\n",
    "\n",
    "\n",
    "def train_model(X_tr, y_tr, X_val, y_val, epochs, X_test=None, y_test=None, log_path=None):\n",
    "    # If log_path is given, one CSV row per epoch is written (same columns as the sample CSV).\n",
    "    set_seed()\n",
    "    model = UltraLightCNN().to(DEVICE)\n",
    "    optimizer = torch.optim.SGD(model.parameters(), lr=LEARNING_RATE, momentum=0.9,\n",
    "                                nesterov=True, weight_decay=WEIGHT_DECAY)\n",
    "    loader = DataLoader(\n",
    "        TensorDataset(X_tr, y_tr),\n",
    "        batch_size=BATCH_SIZE,\n",
    "        shuffle=True,\n",
    "        generator=torch.Generator().manual_seed(SEED),\n",
    "    )\n",
    "    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=epochs * len(loader))\n",
    "    hist = {\"train_loss\": [], \"val_loss\": [], \"train_acc\": [], \"val_acc\": []}\n",
    "    rows = []\n",
    "\n",
    "    for epoch in range(1, epochs + 1):\n",
    "        epoch_start = time.perf_counter()\n",
    "        model.train()\n",
    "        run_loss, correct, run_mae = 0.0, 0, 0.0\n",
    "        for xb, yb in loader:\n",
    "            if USE_AUGMENTATION:\n",
    "                xb = augment_batch(xb)\n",
    "            xb, yb = xb.to(DEVICE), yb.to(DEVICE)\n",
    "            optimizer.zero_grad()\n",
    "            logits = model(xb)\n",
    "            loss = criterion(logits, yb)\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "            scheduler.step()\n",
    "            run_loss += loss.item() * len(yb)\n",
    "            correct += (logits.argmax(1) == yb).sum().item()\n",
    "            with torch.no_grad():\n",
    "                onehot = F.one_hot(yb, 10).float()\n",
    "                run_mae += (torch.softmax(logits, dim=1) - onehot).abs().mean(1).sum().item()\n",
    "\n",
    "        train_loss, train_acc, train_mae = run_loss / len(y_tr), correct / len(y_tr), run_mae / len(y_tr)\n",
    "        val_loss, val_acc, val_mae, _ = evaluate_metrics(model, X_val, y_val)\n",
    "        if X_test is not None:\n",
    "            _, test_acc, _, test_mse = evaluate_metrics(model, X_test, y_test)\n",
    "        else:\n",
    "            test_acc, test_mse = float(\"nan\"), float(\"nan\")\n",
    "\n",
    "        hist[\"train_loss\"].append(train_loss)\n",
    "        hist[\"train_acc\"].append(train_acc)\n",
    "        hist[\"val_loss\"].append(val_loss)\n",
    "        hist[\"val_acc\"].append(val_acc)\n",
    "\n",
    "        if log_path is not None:\n",
    "            row = {\n",
    "                \"Epoch\": epoch,\n",
    "                \"Train Loss\": train_loss,\n",
    "                \"Val Loss\": val_loss,\n",
    "                \"Train MAE\": train_mae,\n",
    "                \"Val MAE\": val_mae,\n",
    "                \"Test MSE\": test_mse,\n",
    "                \"Loss Gap (Val-Train)\": val_loss - train_loss,\n",
    "                \"Epoch Time (s)\": time.perf_counter() - epoch_start,\n",
    "            }\n",
    "            if LOG_ACCURACY_COLUMNS:\n",
    "                row.update({\"Train Acc\": train_acc, \"Val Acc\": val_acc, \"Test Acc\": test_acc})\n",
    "            rows.append(row)\n",
    "            pd.DataFrame(rows).to_csv(log_path, index=False)   # rewritten every epoch, so nothing is lost\n",
    "\n",
    "        if epoch % 10 == 0 or epoch == 1:\n",
    "            print(f\"  epoch {epoch:3d}/{epochs} | train loss {train_loss:.4f} \"\n",
    "                  f\"| val loss {val_loss:.4f} | val acc {val_acc:.4f}\")\n",
    "    return model, hist\n"
   ]
  },
