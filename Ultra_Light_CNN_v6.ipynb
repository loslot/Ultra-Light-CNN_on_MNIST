   "id": "c007",
   "metadata": {},
   "source": [
    "## 4. Subset and split (70% train / 20% test / 10% validate, seed 42)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "c008",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "N=2500: train=1750 (70%), test=500 (20%), val=250 (10%)\n",
      "N=5000: train=3500 (70%), test=1000 (20%), val=500 (10%)\n"
     ]
    }
   ],
   "source": [
    "def make_split(n, seed=SEED):\n",
    "    # Stratified subset of size n, then stratified 70 / 20 / 10 split.\n",
    "    all_idx = np.arange(len(y_all))\n",
    "    idx_sub, _ = train_test_split(\n",
    "        all_idx, train_size=n, stratify=y_all.numpy(), random_state=seed\n",
    "    )\n",
    "    y_sub = y_all[idx_sub].numpy()\n",
    "\n",
    "    idx_train, idx_rest = train_test_split(\n",
    "        idx_sub, train_size=TRAIN_RATIO, stratify=y_sub, random_state=seed\n",
    "    )\n",
    "    y_rest = y_all[idx_rest].numpy()\n",
    "\n",
    "    idx_test, idx_val = train_test_split(\n",
    "        idx_rest,\n",
    "        train_size=TEST_RATIO / (TEST_RATIO + VAL_RATIO),\n",
    "        stratify=y_rest,\n",
    "        random_state=seed,\n",
    "    )\n",
    "    return idx_train, idx_val, idx_test\n",
    "\n",
    "\n",
    "for n in SUBSET_SIZES:\n",
    "    tr, va, te = make_split(n)\n",
    "    print(f\"N={n}: train={len(tr)} ({len(tr)/n:.0%}), test={len(te)} ({len(te)/n:.0%}), val={len(va)} ({len(va)/n:.0%})\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c009",
   "metadata": {},
   "source": [
    "## 5. Gradient noise (15%) for the test set"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "c010",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x350 with 12 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "def add_gradient_noise(x, level=NOISE_LEVEL, sigma=2.0, blur_sigma=BLUR_SIGMA, seed=SEED, generator=None):\n",
    "    # Smooth (low-frequency) noise field whose std equals `level` of the intensity range.\n",
    "    g = generator if generator is not None else torch.Generator().manual_seed(seed)\n",
    "    noise = torch.randn(x.shape, generator=g)\n",
    "    k = int(2 * round(3 * sigma) + 1)\n",
    "    noise = gaussian_blur(noise, kernel_size=[k, k], sigma=[sigma, sigma])\n",
    "    noise = noise / noise.flatten(1).std(dim=1).view(-1, 1, 1, 1)\n",
    "    if torch.is_tensor(level):\n",
    "        level = level.view(-1, 1, 1, 1)\n",
    "    out = x + level * noise\n",
    "    if blur_sigma > 0:\n",
    "        out = gaussian_blur(out, kernel_size=[3, 3], sigma=[blur_sigma, blur_sigma])\n",
    "    return out.clamp(0, 1)\n",
    "\n",
    "\n",
    "# Quick preview\n",
    "preview = X_all[:6]\n",
    "preview_noisy = add_gradient_noise(preview)\n",
    "fig, axes = plt.subplots(2, 6, figsize=(10, 3.5))\n",
    "for i in range(6):\n",
    "    axes[0, i].imshow(preview[i, 0], cmap=\"gray\"); axes[0, i].axis(\"off\")\n",
    "    axes[1, i].imshow(preview_noisy[i, 0], cmap=\"gray\"); axes[1, i].axis(\"off\")\n",
    "axes[0, 0].set_title(\"Original\", loc=\"left\")\n",
    "axes[1, 0].set_title(\"15% gradient noise\", loc=\"left\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
