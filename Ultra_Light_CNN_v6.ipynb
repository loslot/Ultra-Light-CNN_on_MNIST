    "results = {}\n",
    "\n",
    "for n in SUBSET_SIZES:\n",
    "    idx_train, idx_val, idx_test = make_split(n)\n",
    "    X_tr, y_tr = X_all[idx_train], y_all[idx_train]\n",
    "    X_val, y_val = X_all[idx_val], y_all[idx_val]\n",
    "    X_te, y_te = X_all[idx_test], y_all[idx_test]\n",
    "    X_te_noisy = add_gradient_noise(X_te)   # the test set gets 15% gradient noise\n",
    "    if NOISY_VALIDATION:                    # optional: same kind of noise for validation (different noise sample)\n",
    "        X_val = add_gradient_noise(X_val, seed=SEED + 1)\n",
    "\n",
    "    for epochs in EPOCH_LIST:\n",
    "        print(f\"\\n=== {MODEL_NAME} | size={n} | epochs={epochs} ===\")\n",
    "        t0 = time.perf_counter()\n",
    "        log_path = OUTPUT_DIR / f\"epochs_size{n}_epochs{epochs}.csv\"\n",
    "        model, hist = train_model(X_tr, y_tr, X_val, y_val, epochs,\n",
    "                                  X_test=X_te_noisy, y_test=y_te, log_path=log_path)\n",
    "        print(f\"  Epoch log saved: {log_path}\")\n",
    "        elapsed = time.perf_counter() - t0\n",
    "\n",
    "        _, clean_acc, _ = evaluate(model, X_te, y_te)\n",
    "        _, plain_acc, _ = evaluate(model, X_te_noisy, y_te)\n",
    "        noisy_pred = predict_tta(model, X_te_noisy)          # TTA predictions\n",
    "        noisy_acc = (noisy_pred == y_te).float().mean().item()\n",
    "        print(f\"  Test acc (clean): {clean_acc:.4f} | Noisy test: {plain_acc:.4f} -> with TTA {noisy_acc:.4f} | time {elapsed:.1f}s\")\n",
    "\n",
    "        results[(n, epochs)] = {\n",
    "            \"model\": model, \"hist\": hist,\n",
    "            \"X_te\": X_te, \"X_te_noisy\": X_te_noisy, \"y_te\": y_te, \"noisy_pred\": noisy_pred,\n",
    "            \"clean_acc\": clean_acc, \"plain_acc\": plain_acc, \"noisy_acc\": noisy_acc, \"time\": elapsed,\n",
    "        }"
   ]
  },
